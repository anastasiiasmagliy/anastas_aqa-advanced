class Book {
    constructor(title, author, year) {
        this.title = title;
        this.author = author;
        this.year = year;
    }

 isClassic() {
    if (this.year < 1950) {
        return true;
    } else {
        return false;
    }
    
}

getBookAge(currentYear) { return currentYear - this.year}
getInfo() { return `${this.title} — ${this.author} (${this.year})` + (",") + (" ") + ('вік книги:') + (" ") + this.getBookAge(2026)};

}

